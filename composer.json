{
    "name": "tiacx/laravel-aliyun-log",
    "description": "Laravel 阿里云 SLS 日志扩展包：Monolog 日志推送 + 访问日志中间件",
    "type": "library",
    "keywords": ["laravel", "aliyun", "sls", "log"],
    "homepage": "https://github.com/tiacx/laravel-aliyun-log",
    "license": "MIT",
    "authors": [
        {
            "name": "Tiac"
        }
    ],
    "require": {
        "php": "^8.1",
        "alibabacloud/aliyun-log-php-sdk": "^0.7.0",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Tiacx\\AliyunLog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tiacx\\AliyunLog\\AliyunLogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.0.1"
}
